# Configuration Générale Django
SECRET_KEY=django-insecure-ayyou-dev-secret-key-change-in-production-2025
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost

# Base de Données PostgreSQL
DB_ENGINE=django.db.backends.postgresql
DB_NAME=ayyou_db
DB_USER=ayyou_user
DB_PASSWORD=ayyou_password
DB_HOST=127.0.0.1
DB_PORT=5432

# CORS Configuration
CORS_ALLOWED_ORIGINS=http://localhost:4200,http://127.0.0.1:4200

# Cloudinary Storage Configuration (Vidéos & Médias Feed AYYOU)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Email Configuration (Emails Transactionnels)
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=no-reply@example.com
EMAIL_HOST_PASSWORD=your_email_password_here
DEFAULT_FROM_EMAIL=AYYOU <no-reply@ayyou.com>

# Intégrations Automatisation (n8n Webhook)
N8N_PRO_APPROVAL_WEBHOOK_URL=http://localhost:5678/webhook/ayyou/pro-approved
N8N_WEBHOOK_SECRET=your_n8n_webhook_secret_here


